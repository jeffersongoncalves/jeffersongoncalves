{
  "name": "@jeffersongoncalves/jeffersongoncalves",
  "private": true,
  "scripts": {
    "update:plugins": "node update-plugins-compatibility.js",
    "build:readme": "node update-readme.js",
    "build:packages": "node extract-plugin-packages.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^17.5.0"
  },
  "lint-staged": {
    "plugins.json": [
      "node update-plugins-compatibility.js",
      "node extract-plugin-packages.js",
      "git add plugins.json plugins-packages-owner.json plugins-packages-collaborator.json"
    ]
  }
}
